{
	"info": {
		"_postman_id": "7dc21e53-cardiovigia-240-api",
		"name": "CardioVigia 2.4.0 - API Testing Suite",
		"description": "Colección de pruebas automatizadas de API para CardioVigía 2.4.0 (UNSAM V&V)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Health Check y Versión",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/salud",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "salud"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code es 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Version del sistema es 2.4.0', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.version).to.eql('2.4.0');",
							"    pm.expect(jsonData.estado).to.eql('OPERATIVO');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "02 - Validar Signos Vitales Normales",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"frecuenciaCardiaca\": 75,\n    \"presionArterialMedia\": 90,\n    \"saturacionOxigeno\": 99,\n    \"temperatura\": 36.5,\n    \"segundosSinSenal\": 0\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/signos-vitales/validar",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "signos-vitales", "validar"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code es 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Lectura es valida y canal confiable', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.valido).to.eql(true);",
							"    pm.expect(data.canalConfiable).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "03 - Descartar Frecuencia Fuera de Rango (350 lpm)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"frecuenciaCardiaca\": 350,\n    \"presionArterialMedia\": 90,\n    \"saturacionOxigeno\": 99,\n    \"temperatura\": 36.5,\n    \"segundosSinSenal\": 0\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/signos-vitales/validar",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "signos-vitales", "validar"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Lectura es rechazada por fuera de rango', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.valido).to.eql(false);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "04 - Evaluar Elegibilidad Paciente Adulto (45 años)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"id\": \"PAC-45\",\n    \"edad\": 45,\n    \"perfilCompleto\": true,\n    \"faseQuirurgica\": \"Mantenimiento CEC\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/pacientes/elegibilidad",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "pacientes", "elegibilidad"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Paciente es elegible para estimacion con IA', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.elegibleIA).to.eql(true);",
							"    pm.expect(data.modo).to.eql('ESTIMACION_IA');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "05 - Generar Alerta Crítica (85%)",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/alertas/evaluar?pacienteId=PAC-01&probabilidad=85.0",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "alertas", "evaluar"],
					"query": [
						{
							"key": "pacienteId",
							"value": "PAC-01"
						},
						{
							"key": "probabilidad",
							"value": "85.0"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Genera alerta critica sonora', function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.alertaEmitida).to.eql(true);",
							"    pm.expect(data.nivel).to.eql('CRITICO');",
							"    pm.expect(data.notificacion).to.eql('ALERTA_SONORA_ANESTESIOLOGO_Y_CIRUJANO');",
							"    pm.expect(data.factores.length).to.eql(3);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
}
